# Django Core
DJANGO_SECRET_KEY=change-me-in-production-insecure-dev-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_TEST=0

# Database (PostgreSQL compartilhado com projeto-si-backend)
DATABASE_URL=postgres://projeto_si:projeto_si_dev@localhost:5432/projeto_si
POSTGRES_DB=projeto_si
POSTGRES_USER=projeto_si
POSTGRES_PASSWORD=projeto_si_dev

# Biometrics & M2005_Pisani2024_Sliding_Dynamic Parameters
BIOMETRICS_ENROLLMENT_SAMPLES=5
BIOMETRICS_DECISION_THRESHOLD=0.7
BIOMETRICS_LABEL_CONFIDENCE_MARGIN=0.15
BIOMETRICS_RETRAIN_INTERVAL_MINUTES=60
BIOMETRICS_RETRAIN_MIN_NEW_SAMPLES=5
BIOMETRICS_RETRAIN_GENUINE_WINDOW=50
BIOMETRICS_MODELS_DIR=models_data
BIOMETRICS_AUTH_THROTTLE_RATE=30/minute
